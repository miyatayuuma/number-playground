          && request.resource.data.hidden == false
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if member(fid) && (
          (resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reason','url','updatedAt'])
            && request.resource.data.reason is string
            && request.resource.data.reason.size() <= 1000
            && request.resource.data.url is string
            && request.resource.data.url.size() <= 1500
            && (request.resource.data.url == '' || request.resource.data.url.matches('^https://.+'))
            && request.resource.data.updatedAt == request.time)
          ||
          (owner(fid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
            && request.resource.data.hidden is bool
            && request.resource.data.hidden != resource.data.hidden)
        );
        allow delete: if member(fid) && resource.data.authorUid == request.auth.uid;
      }

    }
  }
})
              && exists(linkInvitePath(fid, request.resource.data.inviteToken))
              && get(linkInvitePath(fid, request.resource.data.inviteToken)).data.role == 'viewer'
              && get(linkInvitePath(fid, request.resource.data.inviteToken)).data.claimedByUid == ''
              && get(linkInvitePath(fid, request.resource.data.inviteToken)).data.expiresAt > request.time
              && request.resource.data.role == 'viewer'
              && request.resource.data.joinedAt == request.time
              && getAfter(linkInvitePath(fid, request.resource.data.inviteToken)).data.claimedByUid == uid
              && getAfter(linkInvitePath(fid, request.resource.data.inviteToken)).data.claimedAt == request.time)
          );
        allow update: if owner(fid) && uid != request.auth.uid
          && resource.data.role != 'owner'
          && request.resource.data.uid == uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role in ['editor', 'viewer'];
        allow delete: if owner(fid) && resource.data.role != 'owner';
      }
      match /invites/{email} {
        allow get: if owner(fid) || ownEmail(email);
        allow list: if owner(fid);
        allow create, update: if owner(fid)
          && request.resource.data.email == email
          && request.resource.data.role in ['editor','viewer']
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time;
        allow delete: if owner(fid);
      }
      // ChatGPT sync uses a scoped Google Cloud service account and Admin SDK.
      // Family browser sessions remain read-only even for the owner.
      match /books/{bookId} {
        allow get, list: if member(fid);
        allow create, update, delete: if false;

        // Child observations are formally recorded by the authorized
        // ChatGPT->GitHub->Admin SDK pipeline, not by family web clients.
        match /childReflections/{reflectionId} {
          allow get, list: if member(fid);
          // The Google account that owns this family can append a child's
          // observed words. Members cannot alter the formal record.
          allow create: if owner(fid)
            && request.resource.data.keys().hasOnly(['quote','attribution','observedAt','createdAt','source','authorUid'])
            && request.resource.data.keys().hasAll(['quote','attribution','observedAt','createdAt','source','authorUid'])
            && request.resource.data.quote is string
            && request.resource.data.quote.size() > 0
            && request.resource.data.quote.size() <= 3000
            && request.resource.data.attribution in ['verbatim','parent-summary']
            && request.resource.data.observedAt is string
            && request.resource.data.observedAt.size() <= 100
            && request.resource.data.createdAt == request.time
            && request.resource.data.source == 'owner-app'
            && request.resource.data.authorUid == request.auth.uid;
          allow update, delete: if false;
        }
        match /comments/{commentId} {
          // Listeners must query hidden == false; owners may separately
          // list moderated comments for restoration.
          allow get: if member(fid) && (
            owner(fid) || resource.data.hidden == false ||
            resource.data.authorUid == request.auth.uid
          );
          allow list: if member(fid) && (owner(fid) || resource.data.hidden == false);
          allow create: if member(fid)
            && request.resource.data.keys().hasOnly(['authorUid','body','createdAt','updatedAt','hidden'])
            && request.resource.data.keys().hasAll(['authorUid','body','createdAt','updatedAt','hidden'])
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 2000
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.hidden == false;
          allow update: if member(fid) && (
            (resource.data.authorUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','updatedAt'])
              && request.resource.data.body is string
              && request.resource.data.body.size() > 0
              && request.resource.data.body.size() <= 2000
              && request.resource.data.updatedAt == request.time)
            ||
            (owner(fid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
              && request.resource.data.hidden is bool
              && request.resource.data.hidden != resource.data.hidden)
          );
          allow delete: if member(fid) && resource.data.authorUid == request.auth.uid;
        }
        match /reactions/{uid} {
          allow get, list: if member(fid);
          allow create: if member(fid) && uid == request.auth.uid
            && request.resource.data.keys().hasOnly(['uid','kind','createdAt'])
            && request.resource.data.keys().hasAll(['uid','kind','createdAt'])
            && request.resource.data.uid == uid
            && request.resource.data.kind == 'like'
            && request.resource.data.createdAt == request.time;
          allow update: if false;
          allow delete: if member(fid) && uid == request.auth.uid;
        }
        match /requests/{uid} {
          allow get, list: if member(fid);
          allow create: if member(fid) && uid == request.auth.uid
            && request.resource.data.keys().hasOnly(['uid','kind','createdAt'])
            && request.resource.data.keys().hasAll(['uid','kind','createdAt'])
            && request.resource.data.uid == uid
            && request.resource.data.kind == 'ask-reflection'
            && request.resource.data.createdAt == request.time;
          allow update: if false;
          allow delete: if member(fid) && uid == request.auth.uid;
        }
      }
      match /series/{sid} {
        allow get, list: if member(fid);
        allow create, update, delete: if false;
      }
      // Activity feed stores only who performed which action on which book.
      // No comment text, children's words, email address or recommendation reason.
      match /activity/{activityId} {
        allow get, list: if member(fid);
        allow create: if member(fid)
          && request.resource.data.keys().hasOnly(['actorUid','kind','title','bookId','sourceId','hidden','createdAt'])
          && request.resource.data.keys().hasAll(['actorUid','kind','title','bookId','sourceId','hidden','createdAt'])
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.kind in ['comment','recommendation','reflection']
          && (request.resource.data.kind != 'reflection' || owner(fid))
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 250
          && request.resource.data.bookId is string
          && request.resource.data.bookId.size() <= 128
          && request.resource.data.sourceId is string
          && request.resource.data.sourceId.size() > 0
          && request.resource.data.sourceId.size() <= 128
          && request.resource.data.hidden == false
          && request.resource.data.createdAt == request.time;
        allow update: if owner(fid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
          && request.resource.data.hidden is bool;
        allow delete: if member(fid) && (
          resource.data.actorUid == request.auth.uid || owner(fid)
        );
      }
      match /recommendations/{recommendationId} {
        allow get: if member(fid) && (owner(fid) || resource.data.hidden == false ||
          resource.data.authorUid == request.auth.uid);
        allow list: if member(fid) && (owner(fid) || resource.data.hidden == false);
        allow create: if member(fid)
          && request.resource.data.keys().hasOnly(['authorUid','title','normalizedTitle','reason','url','hidden','createdAt','updatedAt','author','publisher','publishedDate','isbn','coverUrl','metadataSource'])
          && request.resource.data.keys().hasAll(['authorUid','title','normalizedTitle','reason','url','hidden','createdAt','updatedAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 250
          && request.resource.data.normalizedTitle is string
          && request.resource.data.normalizedTitle.size() > 0
          && request.resource.data.normalizedTitle.size() <= 250
          && request.resource.data.reason is string
          && request.resource.data.reason.size() <= 1000
          && request.resource.data.url is string
          && request.resource.data.url.size() <= 1500
          && (request.resource.data.url == '' || request.resource.data.url.matches('^https://.+'))
          && request.resource.data.get('author','') is string
          && request.resource.data.get('author','').size() <= 250
          && request.resource.data.get('publisher','') is string
          && request.resource.data.get('publisher','').size() <= 250
          && request.resource.data.get('publishedDate','') is string
          && request.resource.data.get('publishedDate','').size() <= 35
          && request.resource.data.get('isbn','') is string
          && request.resource.data.get('isbn','').size() <= 13
          && request.resource.data.get('coverUrl','') is string
          && request.resource.data.get('coverUrl','').size() <= 1500
          && (request.resource.data.get('coverUrl','') == '' || request.resource.data.get('coverUrl','').matches('^https://.+'))
          && request.resource.data.get('metadataSource','') is string
          && request.resource.data.get('metadataSource','').size() <= 1500
          && (request.resource.data.get('metadataSource','') == '' || request.resource.data.get('metadataSource','').matches('^https://.+'))
          && request.resource.data.hidden == false
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if member(fid) && (
          (resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reason','url','updatedAt'])
            && request.resource.data.reason is string
            && request.resource.data.reason.size() <= 1000
            && request.resource.data.url is string
            && request.resource.data.url.size() <= 1500
            && (request.resource.data.url == '' || request.resource.data.url.matches('^https://.+'))
            && request.resource.data.updatedAt == request.time)
          ||
          (owner(fid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
            && request.resource.data.hidden is bool
            && request.resource.data.hidden != resource.data.hidden)
        );
        allow delete: if member(fid) && resource.data.authorUid == request.auth.uid;
      }

    }
  }
}