rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function familyPath(fid) {
      return /databases/$(database)/documents/families/$(fid);
    }
    function memberPath(fid, uid) {
      return /databases/$(database)/documents/families/$(fid)/members/$(uid);
    }
    function invitePath(fid, email) {
      return /databases/$(database)/documents/families/$(fid)/invites/$(email);
    }
    function owner(fid) {
      return signedIn() && exists(familyPath(fid))
          && get(familyPath(fid)).data.ownerUid == request.auth.uid;
    }
    function member(fid) {
      return signedIn() && (owner(fid) || exists(memberPath(fid, request.auth.uid)));
    }
    function ownEmail(email) {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email == email;
    }
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.familyId is string
        && member(request.resource.data.familyId)
        && ( !exists(/databases/$(database)/documents/users/$(uid))
             || resource.data.familyId == request.resource.data.familyId);
    }
    match /families/{fid} {
      allow get: if member(fid);
      allow list, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid','name','createdAt','schemaVersion'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt is timestamp;
      allow update: if owner(fid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.schemaVersion == resource.data.schemaVersion;
      match /members/{uid} {
        allow get, list: if member(fid);
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.displayName is string
          && request.resource.data.joinedAt is timestamp
          && (
            (owner(fid) && request.resource.data.role == 'owner') ||
            (request.auth.token.email_verified == true
              && exists(invitePath(fid, request.auth.token.email))
              && get(invitePath(fid, request.auth.token.email)).data.expiresAt > request.time
              && get(invitePath(fid, request.auth.token.email)).data.role == request.resource.data.role
              && request.resource.data.role in ['editor','viewer'])
          );
        allow update: if owner(fid) && uid != request.auth.uid
          && resource.data.role != 'owner'
          && request.resource.data.uid == uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role in ['editor', 'viewer'];
        allow delete: if owner(fid) && resource.data.role != 'owner';
      }
      match /invites/{email} {
        allow get: if owner(fid) || ownEmail(email);
        allow list: if owner(fid);
        allow create, update: if owner(fid)
          && request.resource.data.email == email
          && request.resource.data.role in ['editor','viewer']
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time;
        allow delete: if owner(fid);
      }
      // ChatGPT sync uses a scoped Google Cloud service account and Admin SDK.
      // Family browser sessions remain read-only even for the owner.
      match /books/{bookId} {
        allow get, list: if member(fid);
        allow create, update, delete: if false;

        // Child observations are formally recorded by the authorized
        // ChatGPT->GitHub->Admin SDK pipeline, not by family web clients.
        match /childReflections/{reflectionId} {
          allow get, list: if member(fid);
          allow create, update, delete: if false;
        }
        match /comments/{commentId} {
          // Listeners must query hidden == false; owners may separately
          // list moderated comments for restoration.
          allow get: if member(fid) && (
            owner(fid) || resource.data.hidden == false ||
            resource.data.authorUid == request.auth.uid
          );
          allow list: if member(fid) && (owner(fid) || resource.data.hidden == false);
          allow create: if member(fid)
            && request.resource.data.keys().hasOnly(['authorUid','body','createdAt','updatedAt','hidden'])
            && request.resource.data.keys().hasAll(['authorUid','body','createdAt','updatedAt','hidden'])
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 2000
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.hidden == false;
          allow update: if member(fid) && (
            (resource.data.authorUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','updatedAt'])
              && request.resource.data.body is string
              && request.resource.data.body.size() > 0
              && request.resource.data.body.size() <= 2000
              && request.resource.data.updatedAt == request.time)
            ||
            (owner(fid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
              && request.resource.data.hidden is bool
              && request.resource.data.hidden != resource.data.hidden)
          );
          allow delete: if member(fid) && resource.data.authorUid == request.auth.uid;
        }
        match /reactions/{uid} {
          allow get, list: if member(fid);
          allow create: if member(fid) && uid == request.auth.uid
            && request.resource.data.keys().hasOnly(['uid','kind','createdAt'])
            && request.resource.data.keys().hasAll(['uid','kind','createdAt'])
            && request.resource.data.uid == uid
            && request.resource.data.kind == 'like'
            && request.resource.data.createdAt == request.time;
          allow update: if false;
          allow delete: if member(fid) && uid == request.auth.uid;
        }
        match /requests/{uid} {
          allow get, list: if member(fid);
          allow create: if member(fid) && uid == request.auth.uid
            && request.resource.data.keys().hasOnly(['uid','kind','createdAt'])
            && request.resource.data.keys().hasAll(['uid','kind','createdAt'])
            && request.resource.data.uid == uid
            && request.resource.data.kind == 'ask-reflection'
            && request.resource.data.createdAt == request.time;
          allow update: if false;
          allow delete: if member(fid) && uid == request.auth.uid;
        }
      }
      match /series/{sid} {
        allow get, list: if member(fid);
        allow create, update, delete: if false;
      }
    }
  }
}